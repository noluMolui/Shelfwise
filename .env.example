# Public browser configuration. Replace these values with the local Supabase
# values printed by `npx supabase status` before running the app locally.
VITE_SUPABASE_URL=replace-with-local-supabase-url
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_APP_ENV=local

# Server-side tooling only. Never expose these values to browser code or commit
# real values to Git.
SUPABASE_URL=replace-with-local-supabase-url
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SEED_TEST_PASSWORD=replace-with-a-test-only-password
